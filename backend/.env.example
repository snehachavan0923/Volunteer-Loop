# Local MongoDB server
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=volunteerloop

# Local-development JWT signing secret. Set a long random value for your environment.
VOLUNTEERLOOP_SECRET_KEY=replace-this-with-a-long-random-secret

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional email reminders; in-app notifications work without an email provider.
RESEND_API_KEY=
EMAIL_FROM=
